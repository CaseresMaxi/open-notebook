# Copy to .firebase/home-runtime.env (git-ignored) and fill in.
# Accounts: Firebase Authentication. Everything else: this computer.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_WEB_CONFIG={"apiKey":"public-web-key","authDomain":"your-project.firebaseapp.com","projectId":"your-project-id","appId":"public-app-id"}
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/nextnootbook-firebase.json

# The owner always opens the original installation (all existing notebooks and
# sources), even if the Firebase account is ever deleted and recreated, is
# never disabled and has no usage limits. Other accounts get private workspaces.
NEXTNOOTBOOK_ADMIN_EMAIL=owner@example.com
NEXTNOOTBOOK_OWNER_EMAIL=owner@example.com
NEXTNOOTBOOK_LEGACY_OWNER_FILE=/app/data/account-owner.json

# Every address you type in the browser, with port 8502. Prefer a reserved
# DHCP address or the mDNS name (<hostname>.local) so it does not change.
NEXTNOOTBOOK_ALLOWED_ORIGINS=http://localhost:8502,http://127.0.0.1:8502,http://192.168.1.10:8502,http://myhost.local:8502
CORS_ORIGINS=http://localhost:8502,http://127.0.0.1:8502,http://192.168.1.10:8502,http://myhost.local:8502

# Plain HTTP cookies, accepted only for private-network origins (192.168.x,
# 10.x, 172.16-31.x, *.local, *.lan, *.home.arpa). Never on a public domain.
NEXTNOOTBOOK_INSECURE_LOCAL_COOKIES=true
NEXTNOOTBOOK_LAN_HTTP=true

NEXTNOOTBOOK_DATABASE_BACKEND=surrealdb
NEXTNOOTBOOK_STORAGE_BACKEND=local
NEXTNOOTBOOK_DATA_ROOT=/app/data
NEXTNOOTBOOK_USAGE_DB=/app/data/platform/usage.sqlite
