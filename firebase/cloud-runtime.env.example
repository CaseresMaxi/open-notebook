# Non-secret template. Keep the encryption key in Secret Manager, using exactly
# the existing installation key so migrated credentials remain readable.
FIREBASE_PROJECT_ID=nextnootbook-dev
FIREBASE_STORAGE_BUCKET=nextnootbook-dev.firebasestorage.app
FIREBASE_WEB_CONFIG={"projectId":"nextnootbook-dev","apiKey":"PUBLIC_WEB_KEY","authDomain":"nextnootbook-dev.firebaseapp.com"}
NEXTNOOTBOOK_OWNER_UID=REPLACE_WITH_VERIFIED_OWNER_UID
NEXTNOOTBOOK_ADMIN_EMAIL=maxycaseres5@gmail.com
NEXTNOOTBOOK_ALLOWED_ORIGINS=https://REPLACE_WITH_FRONTEND_HOST
CORS_ORIGINS=https://REPLACE_WITH_FRONTEND_HOST
NEXTNOOTBOOK_WORKER_URL=https://REPLACE_WITH_PRIVATE_WORKER_RUN_HOST
NEXTNOOTBOOK_TASKS_SERVICE_ACCOUNT=nextnootbook-tasks@nextnootbook-dev.iam.gserviceaccount.com
NEXTNOOTBOOK_TASKS_REGION=us-east1
NEXTNOOTBOOK_TASKS_QUEUE=study-jobs
NEXTNOOTBOOK_DATABASE_BACKEND=firestore
NEXTNOOTBOOK_STORAGE_BACKEND=firebase
NEXTNOOTBOOK_AUTH_MODE=firebase
NEXTNOOTBOOK_MAX_ACCOUNTS=4
NEXTNOOTBOOK_DATA_ROOT=/app/data
